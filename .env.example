# AvatarLink provider presets (placeholders only — do not commit real secrets)
VITE_OPENROUTER_API_BASE=https://openrouter.ai/api/v1
VITE_GITHUB_MODELS_PROXY_BASE=http://127.0.0.1:8787/api/github-models
VITE_GEMINI_PROXY_BASE=http://127.0.0.1:8787/api/gemini
VITE_OLLAMA_API_BASE=http://localhost:11434/v1
VITE_OPENAI_API_BASE=https://api.openai.com/v1

# Optional default model placeholders
VITE_OPENROUTER_MODEL=openrouter/auto
VITE_GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
VITE_GEMINI_MODEL=gemini-2.0-flash
VITE_OLLAMA_MODEL=llama3.2
VITE_OPENAI_MODEL=gpt-4o-mini

# OAuth-ready provider connector placeholders only
# Do not put session cookies here. Do not scrape ChatGPT web sessions.
VITE_PROVIDER_OAUTH_CALLBACK_URL=http://localhost:4173/oauth/callback
VITE_PROVIDER_OAUTH_CLIENT_ID=placeholder-client-id
VITE_PROVIDER_OAUTH_SCOPES=openid profile provider.read

# Local BYOK secrets belong in .env.local only (gitignored)
# GITHUB_TOKEN belongs in .env.local only; never expose it in frontend source or VITE variables
# GEMINI_API_KEY belongs in .env.local only; never expose it in frontend source
# GITHUB_MODELS_MODEL=openai/gpt-4.1-mini is safe as a non-secret local default
