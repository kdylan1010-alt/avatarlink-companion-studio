# AvatarLink provider presets (placeholders only — do not commit real secrets)
VITE_OPENROUTER_API_BASE=https://openrouter.ai/api/v1
VITE_GITHUB_MODELS_PROXY_BASE=http://127.0.0.1:8787/api/github-models
VITE_DEEPSEEK_PROXY_BASE=http://127.0.0.1:8787/api/deepseek
VITE_GEMINI_PROXY_BASE=http://127.0.0.1:8787/api/gemini
VITE_OLLAMA_API_BASE=http://localhost:11434/v1
VITE_LOCAL_ROUTER_API_BASE=http://127.0.0.1:8788/v1
VITE_OPENAI_API_BASE=https://api.openai.com/v1

# Optional default model placeholders
VITE_OPENROUTER_MODEL=openrouter/auto
VITE_GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
VITE_DEEPSEEK_MODEL=deepseek-chat
VITE_GEMINI_MODEL=gemini-2.0-flash
VITE_OLLAMA_MODEL=llama3.2
VITE_LOCAL_ROUTER_MODEL=openai/gpt-4.1-mini
VITE_OPENAI_MODEL=gpt-4o-mini

# Optional local-router API key if your own gateway requires auth.
# Leave blank for unauthenticated local dev routers.
VITE_LOCAL_ROUTER_API_KEY=

# Direct LLM provider lanes for motion + voice (proxy routes /api/<lane>/generate).
# Non-secret bases + model defaults are safe here; the matching *_API_KEY secrets
# belong in .env.local only (gitignored). OPENAI_API_KEY is shared with the TTS lane.
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
ANTHROPIC_API_BASE=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6
# Secrets for the lanes (put real values in .env.local only):
# OPENAI_API_KEY, DEEPSEEK_API_KEY, QWEN_API_KEY (or DASHSCOPE_API_KEY), ANTHROPIC_API_KEY

# OAuth-ready provider connector placeholders only (frontend display)
# Do not put session cookies here. Do not scrape ChatGPT web sessions.
VITE_PROVIDER_OAUTH_CALLBACK_URL=http://localhost:4173/oauth/callback
VITE_PROVIDER_OAUTH_CLIENT_ID=placeholder-client-id
VITE_PROVIDER_OAUTH_SCOPES=openid profile provider.read

# Server-side provider OAuth connector (the REAL route lives in scripts/gemini-proxy.mjs).
# These configure /oauth/start + /oauth/callback + /oauth/status. The client secret and the
# obtained access token are server-side only and never reach the browser. Placeholders only
# here; put real values in .env.local (gitignored). The obtained token is used by the
# GitHub Models LLM lane that drives motion cues + the spoken reply.
PROVIDER_OAUTH_AUTHORIZE_URL=https://provider.example/login/oauth/authorize
PROVIDER_OAUTH_TOKEN_URL=https://provider.example/login/oauth/access_token
PROVIDER_OAUTH_CLIENT_ID=placeholder-client-id
PROVIDER_OAUTH_CLIENT_SECRET=placeholder-client-secret-local-only
PROVIDER_OAUTH_SCOPES=openid profile provider.read
# Must match the redirect URI registered in the provider's OAuth app. Use the public
# tunnel URL in real use (e.g. https://<tunnel>/oauth/callback); loopback is for local dev.
PROVIDER_OAUTH_CALLBACK_URL=http://127.0.0.1:8787/oauth/callback
# Optional: where the browser is sent after a successful connect (e.g. the app URL)
PROVIDER_OAUTH_REDIRECT_AFTER=http://127.0.0.1:8008/avatarlink-companion-studio/

# Local BYOK secrets belong in .env.local only (gitignored)
# GITHUB_TOKEN belongs in .env.local only; never expose it in frontend source or VITE variables
# GEMINI_API_KEY belongs in .env.local only; never expose it in frontend source
# GITHUB_MODELS_MODEL=openai/gpt-4.1-mini is safe as a non-secret local default
